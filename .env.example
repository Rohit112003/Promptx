# ============================================================================
# Tokenised Fund Servicing Platform — example environment.
# Copy to `.env`. All keys below are WELL-KNOWN public Hardhat dev keys — they
# hold no real value and must NEVER be used on a public network.
# ============================================================================

# ---- App ----
LOG_LEVEL=INFO
ENVIRONMENT=local

# ---- Chain ----
# inmemory = web3 + eth-tester (no Node needed). hardhat = connect to npx hardhat node.
CHAIN_MODE=inmemory
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
FUND_NAME=Global Tech Fund
INITIAL_UNIT_PRICE=10000000000        # 100.00000000 (PRICE_SCALE = 1e8)
EVENT_START_BLOCK=0

# ---- Database ----
# sqlite = zero-setup default. mongo = use MONGO_URL (falls back to sqlite if down).
DB_MODE=sqlite
MONGO_URL=mongodb://localhost:27017
MONGO_DB=fund_servicing

# ---- Auth ----
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ---- CORS (comma-separated; frontend-ready) ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Well-known local dev signing keys (Hardhat mnemonic accounts 0-9) ----
DEV_ADMIN_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
DEV_TRANSFER_AGENT_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
DEV_CUSTODIAN_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
DEV_AUDITOR_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
DEV_INVESTOR_KEYS=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a,0x8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba,0x92db14e403b83dfe3df233f83dfa3a0d7096f21ca9b0d6d6b8d88b2b4ec1564e,0x4bbbf85ce3377467afe5d46f804f221813b2bb87f24d81f60f1fcdbf7cbf4356,0xdbda1821b80551c9d65939329250298aa3472ba22feea921c0cf5d620ea67b97
